<?xml version="1.0"?>
<package format="3">
  <name>fr3_dual_arm_bringup</name>
  <version>0.1.0</version>
  <description>Unified simulation, mock and real launch entry points for the dual-arm FR3 cell.</description>
  <maintainer email="maintainer@example.com">FR3 dual-arm maintainer</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>fr3_dual_arm_description</exec_depend>
  <exec_depend>fr3_dual_arm_moveit_config</exec_depend>
  <exec_depend>fr3_dual_arm_gazebo</exec_depend>
  <exec_depend>fr3_dual_arm_hardware</exec_depend>
  <exec_depend>fr3_dual_arm_grasp</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
