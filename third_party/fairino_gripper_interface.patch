+double FairinoHardwareInterface::gripper_position_for_percent(
+    std::uint8_t percent) const
+{
+    const double p = std::clamp(static_cast<double>(percent), 0.0, 100.0);
+    const double ratio = std::clamp(
+        (p - _gripper_open_pos) /
+        static_cast<double>(_gripper_closed_pos - _gripper_open_pos),
+        0.0, 1.0);
+    return (_gripper_open_gap / 2.0) * (1.0 - ratio);
+}
+
+std::uint8_t FairinoHardwareInterface::gripper_percent_for_position(
+    double joint_position) const
+{
+    const double ratio = 1.0 - std::clamp(
+        joint_position / (_gripper_open_gap / 2.0), 0.0, 1.0);
+    const double p = std::clamp(
+        _gripper_open_pos + ratio * (_gripper_closed_pos - _gripper_open_pos),
+        0.0, 100.0);
+    return static_cast<std::uint8_t>(std::lround(p));
+}
