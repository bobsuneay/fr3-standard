+bool parse_int(const std::string & value, int low, int high, int & output)
+{
+  try {
+    std::size_t used = 0;
+    const int parsed = std::stoi(value, &used);
+    if (used != value.size() || parsed < low || parsed > high) {
+      return false;
+    }
+    output = parsed;
+    return true;
+  } catch (...) {
+    return false;
+  }
+}
+
+bool parse_double(const std::string & value, double low, double high, double & output)
+{
+  try {
+    std::size_t used = 0;
+    const double parsed = std::stod(value, &used);
+    if (used != value.size() || !std::isfinite(parsed) ||
+        parsed < low || parsed > high) {
+      return false;
+    }
+    output = parsed;
+    return true;
+  } catch (...) {
+    return false;
+  }
+}
+
